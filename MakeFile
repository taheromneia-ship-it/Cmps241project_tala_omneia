CC = gcc
CFLAGS = -std=c11 -Wall -Wextra -Wpedantic -g -O0
OBJ = main.o board.o game.o input.o

dots: $(OBJ)
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $(OBJ) $(LDLIBS)

main.o: main.c board.h game.h input.h
board.o: board.c board.h
game.o: game.c game.h board.h
input.o: input.c input.h game.h board.h

.PHONY: clean
clean:
	rm -f $(OBJ) dots
